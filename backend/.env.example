# Catch Me backend — local development environment template.
# Copy to .env (git-ignored) and fill in real values. Never commit secrets.

# PostgreSQL connection (matches infra/docker-compose.yml defaults).
CM_DATABASE_URL=postgresql+psycopg://catch_me:catch_me@127.0.0.1:5432/catch_me

# Set to true when serving behind HTTPS (production). Cookies need Secure.
CM_COOKIE_SECURE=false

# Explore quest geofence — REQUIRED before any explore quest can be created.
# No default destination is invented; set your actual outdoor demo spot.
CM_GEOFENCE_LAT=
CM_GEOFENCE_LON=
CM_GEOFENCE_RADIUS_M=50

# Quest durations (ms) — defaults follow docs/PROJECT_SPEC.md; override for tests.
# CM_QUEST_TOGETHER_NORMAL_MS=600000
# CM_QUEST_TOGETHER_DEMO_MS=30000
# CM_QUEST_EXPLORE_NORMAL_MS=120000
# CM_QUEST_EXPLORE_DEMO_MS=20000
# CM_QUEST_HEART_NORMAL_MS=30000
# CM_QUEST_HEART_DEMO_MS=10000

# Seed identities (backend/seed.py). If passwords/pairing codes are omitted,
# random ones are generated and printed to the console once.
# CM_SEED_USER_A=miya
# CM_SEED_USER_B=toma
# CM_SEED_PASSWORD_A=
# CM_SEED_PASSWORD_B=
# CM_SEED_PAIRING_CODE_A=
# CM_SEED_PAIRING_CODE_B=
